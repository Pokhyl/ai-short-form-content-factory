    {"parameters":{"resource":"database","operation":"executeQuery","query":"UPDATE content_jobs SET video_status=$2, status=CASE WHEN $2='ready' THEN 'ready' WHEN $2='failed' THEN 'failed' ELSE status END, output_path=CASE WHEN $2='ready' THEN '/opt/ai-short-form-content-factory/data/videos/'||video_id||'.mp4' ELSE output_path END, error_message=CASE WHEN $2='failed' THEN 'video engine reported failed' ELSE error_message END, updated_at=now() WHERE job_id=$1::uuid RETURNING job_id,status,video_id,video_status,output_path,error_message,created_at,updated_at;","options":{"queryReplacement":"={{ [$('Validate Job ID').item.json.jobId, $json.status] }}"}},"id":"fcdf9ce9-b018-4306-a160-5199e6da8230","name":"Sync Status","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[1680,-240],"credentials":{"postgres":{"id":"cfpg_a1581dfa57ce3198","name":"Content Factory PostgreSQL"}}},

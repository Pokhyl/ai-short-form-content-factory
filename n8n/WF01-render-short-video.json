    {"parameters":{"resource":"database","operation":"executeQuery","query":"SELECT CASE WHEN j.job_id IS NULL THEN false ELSE true END AS found, j.job_id, j.status, j.video_id, j.language FROM (SELECT $1::uuid AS requested_job_id) q LEFT JOIN content_jobs j ON j.job_id=q.requested_job_id;","options":{"queryReplacement":"={{ [$json.jobId] }}"}},"id":"cd4bbae4-4d4e-43ea-b570-356431749593","name":"Load Job","type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[720,-120],"credentials":{"postgres":{"id":"cfpg_a1581dfa57ce3198","name":"Content Factory PostgreSQL"}}},

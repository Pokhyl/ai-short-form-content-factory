    {"parameters":{"jsCode":"const body = $json.body ?? $json;\nconst jobId = typeof body.job_id === 'string' ? body.job_id.trim() : '';\nconst uuidRe = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst errors = [];\nif (!uuidRe.test(jobId)) errors.push('job_id must be a valid UUID v4');\nif (!Array.isArray(body.scenes) || body.scenes.length === 0) errors.push('scenes must be a non-empty array');\nif (Array.isArray(body.scenes)) {\n  for (const [i, scene] of body.scenes.entries()) {\n    if (!scene || typeof scene.text !== 'string' || !scene.text.trim()) errors.push(`scene ${i + 1}: text is required`);\n    if (!scene || !Array.isArray(scene.searchTerms) || scene.searchTerms.length === 0) errors.push(`scene ${i + 1}: searchTerms must be a non-empty array`);\n  }\n}\nreturn [{json:{valid:errors.length===0,errors,jobId,scenes:body.scenes ?? [],config:{paddingBack:Number.isFinite(body.paddingBack)?body.paddingBack:500,music:body.music??'chill',captionPosition:body.captionPosition??'bottom',captionBackgroundColor:body.captionBackgroundColor??'blue',voice:body.voice??'af_heart',orientation:'portrait',musicVolume:body.musicVolume??'low'}}}];"},"id":"3fdeac9a-1f90-41c7-863b-4328d2b8a81e","name":"Validate & Normalize","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,0]},

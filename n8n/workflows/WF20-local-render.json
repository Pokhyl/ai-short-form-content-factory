        "typeVersion": 2,
        "position": [
          -540,
          0
        ],
        "id": "40f788f0-6ab5-42f7-a582-5d0ed90a3002",
        "name": "Validate Job ID"
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT id AS job_id, language, target_duration_seconds, script_json, audio_path,\n       audio_sample_rate, audio_channels, audio_mime_type, tts_synthesis_count\nFROM public.jobs\nWHERE id=$1\n  AND status='voice_ready'\n  AND tts_synthesis_count=1;",
          "options": {
            "queryReplacement": "={{ [ $json.job_id ] }}"
          }
        },
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [
          -320,

        "name": "Build Local Video"
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "UPDATE public.jobs\nSET status='rendered',\n    video_path=$2,\n    audio_duration_seconds=$3,\n    video_duration_seconds=$4,\n    visual_assets=$5::jsonb,\n    timing_json=$6::jsonb,\n    render_qa=$7::jsonb,\n    updated_at=now()\nWHERE id=$1\nRETURNING id AS job_id, status, video_path, audio_duration_seconds, video_duration_seconds, render_qa;",
          "options": {
            "queryReplacement": "={{ [ $json.job_id, $json.video_path, $json.audio_duration_seconds, $json.video_duration_seconds, JSON.stringify($json.visual_assets), JSON.stringify($json.timing), JSON.stringify($json.qa) ] }}"
          }
        },

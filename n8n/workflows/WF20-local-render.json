          }
        }
      },
      {
        "parameters": {
          "url": "http://shorts-v2-media-worker:3001/build",
          "method": "POST",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ ({ job_id: $json.job_id, language: $json.language, target_duration_seconds: $json.target_duration_seconds, script_json: $json.script_json, audio_path: $json.audio_path, audio_sample_rate: $json.audio_sample_rate, audio_channels: $json.audio_channels, audio_mime_type: $json.audio_mime_type }) }}",
          "options": {
            "timeout": 600000

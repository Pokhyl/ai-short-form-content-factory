      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH target_job AS (\n SELECT j.id,j.topic,j.language_code,j.target_duration_seconds,j.status,j.current_stage,j.final_video_path,j.last_error,\n        j.script_text,j.voiceover_duration_seconds,j.voiceover_provider,j.voiceover_model,j.voiceover_voice,\n        j.review_decision,j.review_notes,j.reviewed_at,j.created_at,j.updated_at\n FROM public.jobs j WHERE j.id=$1::uuid\n), scene_rows AS (\n SELECT s.id,s.job_id,s.scene_number,s.narration,s.visual_query,s.reference_query,s.visual_evidence_type,\n        s.exact_subject_type,s.exact_subject,s.beat_start_seconds,s.beat_end_seconds,s.duration_seconds,s.visual_path,\n        COALESCE(jsonb_agg(jsonb_build_object(\n          'provider',a.provider,'provider_asset_id',a.provider_asset_id,'source_url',a.source_url,'author',a.author,\n          'license',a.license,'license_url',a.license_url,'local_path',a.local_path,'metadata',a.metadata\n        ) ORDER BY a.created_at) FILTER (WHERE a.id IS NOT NULL),'[]'::jsonb) AS assets\n FROM public.scenes s LEFT JOIN public.assets a ON a.scene_id=s.id\n WHERE s.job_id=$1::uuid GROUP BY s.id\n), job_payload AS (\n SELECT jsonb_build_object(\n  'job_id',j.id::text,'topic',j.topic,'language_code',j.language_code,'target_duration_seconds',j.target_duration_seconds,\n  'status',j.status,'current_stage',j.current_stage,'final_video_path',j.final_video_path,'last_error',j.last_error,\n  'script_text',j.script_text,'voiceover_duration_seconds',j.voiceover_duration_seconds,'voiceover_provider',j.voiceover_provider,\n  'voiceover_model',j.voiceover_model,'voiceover_voice',j.voiceover_voice,'review_decision',j.review_decision,\n  'review_notes',j.review_notes,'reviewed_at',j.reviewed_at,'created_at',j.created_at,'updated_at',j.updated_at,\n  'scenes',COALESCE((SELECT jsonb_agg(to_jsonb(sr)-'id'-'job_id' ORDER BY sr.scene_number) FROM scene_rows sr),'[]'::jsonb)\n ) AS job FROM target_job j\n)\nSELECT EXISTS(SELECT 1 FROM target_job) AS found,(SELECT job FROM job_payload) AS job;",
          "options": {
            "queryReplacement": "={{ [ $('Normalize Review Job Input').first().json.job_id ] }}"
          }

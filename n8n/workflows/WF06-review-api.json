      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH existing AS (\n SELECT id,status,current_stage FROM public.jobs WHERE id=$1::uuid\n), updated AS (\n UPDATE public.jobs SET review_decision=$2,review_notes=NULLIF($3,''),reviewed_at=now(),updated_at=now()\n WHERE id=$1::uuid AND status='review_ready' AND current_stage='review'\n RETURNING id::text AS job_id,review_decision,review_notes,reviewed_at,updated_at\n)\nSELECT EXISTS(SELECT 1 FROM existing) AS found,EXISTS(SELECT 1 FROM updated) AS updated,\n       (SELECT status FROM existing) AS current_status,(SELECT current_stage FROM existing) AS current_stage,\n       (SELECT to_jsonb(updated) FROM updated) AS review;",
          "options": {
            "queryReplacement": "={{ [ $('Normalize Review Decision').first().json.job_id, $('Normalize Review Decision').first().json.decision, $('Normalize Review Decision').first().json.notes ?? '' ] }}"
          }
        },
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [
          -280,
          340
        ],
        "id": "21e2369a-2bdc-4887-98cf-a54c78c05117",
        "name": "Persist Review Decision",
        "credentials": {
          "postgres": {
            "id": "AdVJ2zREIvjZqGH5",
            "name": "Application PostgreSQL"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const row=$json;if(!row.found)return [{json:{status_code:404,response_body:{error:'not_found'}}}];if(!row.updated)return [{json:{status_code:409,response_body:{error:'not_review_ready',status:row.current_status,current_stage:row.current_stage}}}];return [{json:{status_code:200,response_body:row.review}}];"
        },

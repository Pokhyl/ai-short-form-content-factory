      {
        "parameters": {
          "jsCode": "const body=$json.body??{};const rawJobId=body.job_id;const rawDecision=body.decision;const rawNotes=body.notes;const jobId=typeof rawJobId==='string'?rawJobId.trim().toLowerCase():'';const decision=typeof rawDecision==='string'?rawDecision.trim().toLowerCase():'';let notes=null;let notesTypeValid=true;if(rawNotes!==undefined&&rawNotes!==null){if(typeof rawNotes!=='string'){notesTypeValid=false;}else{notes=rawNotes.trim();if(notes==='')notes=null;}}const rx=/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;const errors=[];if(!rx.test(jobId))errors.push('job_id must be a valid UUID');if(!['approved','rejected'].includes(decision))errors.push('decision must be approved or rejected');if(!notesTypeValid)errors.push('notes must be a string when provided');if(typeof notes==='string'&&notes.length>4000)errors.push('notes must not exceed 4000 characters');return [{json:{valid:errors.length===0,job_id:jobId,decision,notes,errors}}];"
        },

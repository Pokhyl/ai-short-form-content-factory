          "query": "SELECT COALESCE(jsonb_agg(to_jsonb(recent) ORDER BY recent.created_at DESC),'[]'::jsonb) AS jobs\nFROM (\n SELECT id::text AS job_id,topic,language_code,target_duration_seconds,status,current_stage,final_video_path,\n        review_decision,review_notes,reviewed_at,created_at,updated_at\n FROM public.jobs ORDER BY created_at DESC LIMIT 25\n) recent;",

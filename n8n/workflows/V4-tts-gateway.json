        "name": "Webhook",
        "webhookId": "108ded8e-288f-43e4-a86e-04b5f57682ca"
      },
      {
        "parameters": {
          "jsCode": "const b=$json.body??{};const text=String(b.text??'').replace(/\\s+/gu,' ').trim();const language=String(b.language_code??'').toLowerCase();if(!text||text.length>12000)throw new Error('text must contain 1-12000 characters');if(!['en','pl','ru','uk'].includes(language))throw new Error('unsupported TTS language');const style={en:'Speak in natural conversational English with confident documentary pacing.',pl:'Mów naturalnie po polsku, pewnym dokumentalnym tonem.',ru:'Говори естественно по-русски, уверенным документальным тоном.',uk:'Говори природно українською, впевненим документальним тоном.'}[language];return [{json:{request_body:{contents:[{parts:[{text:style+'\\n\\n'+text}]}],generationConfig:{responseModalities:['AUDIO'],speechConfig:{voiceConfig:{prebuiltVoiceConfig:{voiceName:'Kore'}}}}}}}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -280,
          0
        ],
        "id": "83ef83b0-0981-4799-8b29-f50620b4150e",
        "name": "Build Request"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ $json.request_body }}",
          "options": {
            "timeout": 90000
          }
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          0,
          0
        ],
        "id": "d794dd23-dd33-4fe1-8618-7b2a7d924d0f",
        "name": "Gemini",
        "credentials": {
          "httpHeaderAuth": {
            "id": "6Vb7V9YzIwp9LS8S",
            "name": "Google Gemini API"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const r=$json;const part=r?.candidates?.[0]?.content?.parts?.find(x=>x?.inlineData?.data);const data=String(part?.inlineData?.data??'');const mime=String(part?.inlineData?.mimeType??'');if(!data||!mime.toLowerCase().startsWith('audio/'))throw new Error('Gemini TTS returned no audio');return [{json:{audio_base64:data,mime_type:mime,provider:'google_gemini',model:'gemini-2.5-flash-preview-tts',voice:'Kore'}}];"
        },
        "type": "n8n-nodes-base.code",

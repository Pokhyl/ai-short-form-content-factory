      {
        "parameters": {
          "jsCode": "const b=$json.body??{};\nconst prompt=String(b.prompt??'').trim();\nconst multimodal=Array.isArray(b.input)?b.input.filter(x=>x&&typeof x==='object'):[];\nif(!prompt&&!multimodal.length)throw new Error('prompt or multimodal input required');\nconst temperature=Number(b.temperature);\nreturn [{json:{request_body:{prompt,input:multimodal,temperature:Number.isFinite(temperature)?temperature:0.05}}}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -280,
          0
        ],
        "id": "83ef83b0-0981-4799-8b29-f50620b4150e",
        "name": "Build Request"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://model-worker:3002/generate",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ $json.request_body }}",
          "options": {
            "timeout": 160000
          }
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          0,
          0
        ],
        "id": "d794dd23-dd33-4fe1-8618-7b2a7d924d0f",
        "name": "Local Model Worker"
      },
      {
        "parameters": {
          "jsCode": "const r=$json;const text=String(r.text??'').trim();if(!text)throw new Error('self-hosted model returned empty response');return [{json:{text,citations:[],model:String(r.model??'ollama-local'),provider:String(r.provider??'ollama_self_hosted'),interaction_id:''}}];"
        },
        "type": "n8n-nodes-base.code",

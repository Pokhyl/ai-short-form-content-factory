          "jsCode": "return [{json:{text:String($json.text??'').trim(),citations:[],model:String($json.model??''),interaction_id:String($json.interaction_id??''),provider:'kilo',provider_attempts:$json.provider_attempts??[],provider_exhausted:false}}];"
        },

        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const r=$json,ctx=$('Normalize Kilo Response').first().json;let text='';for(const step of (r.steps??[])){if(step?.type!=='model_output')continue;for(const c of (step.content??[])){if(c?.type==='text')text+=String(c.text??'');}}text=text.trim();const err=String(r?.error?.message??r?.message??'').trim();const attempts=[...(ctx.provider_attempts??[]),{provider:'google_gemini',model:String(r?.model??'gemini-3.1-flash-lite'),success:Boolean(text),error:text?null:(err||'empty model output')}];return [{json:{text,citations:[],model:text?String(r?.model??'gemini-3.1-flash-lite'):'',interaction_id:text?String(r?.id??''):'',provider:text?'google_gemini':'none',provider_attempts:attempts,provider_exhausted:!text}}];"
        },

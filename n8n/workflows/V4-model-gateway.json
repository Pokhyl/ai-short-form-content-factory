        "webhookId": "2c17b6de-5b19-4958-a73a-b7855577c384"
      },
      {
        "parameters": {
          "jsCode": "const b=$json.body??{};\nconst prompt=String(b.prompt??'').trim();\nconst multimodal=Array.isArray(b.input)?b.input.filter(x=>x&&typeof x==='object'):[];\nif(!prompt&&!multimodal.length)throw new Error('prompt or multimodal input required');\nconst toKiloItem=(item)=>{if(item?.type==='text')return {type:'text',text:String(item.text??'')};if(item?.type==='image'){const mime=String(item.mime_type??'image/jpeg').trim()||'image/jpeg';const data=String(item.data??'').trim();const uri=String(item.uri??'').trim();const url=data?`data:${mime};base64,${data}`:uri;if(!url)return null;return {type:'image_url',image_url:{url}};}return null;};\nconst kiloContent=multimodal.length?multimodal.map(toKiloItem).filter(Boolean):prompt;\nif(Array.isArray(kiloContent)&&!kiloContent.length)throw new Error('multimodal input has no supported items');\nconst kilo_request_body={model:'stepfun/step-3.7-flash:free',messages:[{role:'user',content:kiloContent}],max_tokens:4096,temperature:0.2};\nconst gemini_request_body={model:'gemini-3.1-flash-lite',input:multimodal.length?multimodal:prompt,generation_config:{thinking_level:'minimal'},store:false};\nreturn [{json:{kilo_request_body,gemini_request_body,provider_attempts:[]}}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -300,
          0
        ],
        "id": "83ef83b0-0981-4799-8b29-f50620b4150e",
        "name": "Build Request"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://api.kilo.ai/api/gateway/chat/completions",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ $json.kilo_request_body }}",
          "options": {
            "timeout": 90000
          }
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.5,
        "position": [
          -40,
          -120
        ],
        "id": "c637ff93-95d6-4429-b9fb-50b30cc2cae4",
        "name": "Kilo Free Model",
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const r=$json,ctx=$('Build Request').first().json;const msg=(r.choices??[])[0]?.message??{};let text='';if(typeof msg.content==='string')text=msg.content.trim();else if(Array.isArray(msg.content))text=msg.content.map(x=>typeof x==='string'?x:String(x?.text??'')).join('').trim();const err=String(r?.error?.message??r?.message??'').trim();const success=Boolean(text);return [{json:{...ctx,kilo_success:success,text:success?text:'',citations:[],model:success?String(r?.model??'stepfun/step-3.7-flash:free'):'',interaction_id:success?String(r?.id??''):'',provider:success?'kilo':'',provider_attempts:[{provider:'kilo',model:'stepfun/step-3.7-flash:free',success,error:success?null:(err||'empty model output')}]}}];"
        },
        "type": "n8n-nodes-base.code",

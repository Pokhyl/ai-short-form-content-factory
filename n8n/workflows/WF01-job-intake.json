        "parameters": {
          "jsCode": "const body = $json.body ?? {};\n\nconst topic = typeof body.topic === 'string'\n  ? body.topic.replace(/\\s+/g, ' ').trim()\n  : '';\n\nconst language = typeof body.language === 'string'\n  ? body.language.trim().toLowerCase()\n  : '';\n\nconst rawDuration = body.duration;\nconst duration = typeof rawDuration === 'number'\n  ? rawDuration\n  : (typeof rawDuration === 'string' && rawDuration.trim() !== '')\n    ? Number(rawDuration)\n    : Number.NaN;\n\nconst errors = [];\n\nif (!topic || topic.length > 500) {\n  errors.push('topic must be a non-empty string up to 500 characters');\n}\n\nif (!['en', 'pl', 'ru', 'uk'].includes(language)) {\n  errors.push('language must be one of: en, pl, ru, uk');\n}\n\nif (![15, 30, 45, 60].includes(duration)) {\n  errors.push('duration must be one of: 15, 30, 45, 60');\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    topic,\n    language,\n    target_duration_seconds: [15, 30, 45, 60].includes(duration) ? duration : null,\n    errors,\n  },\n}];"
        },
        "type": "n8n-nodes-base.code",

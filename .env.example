# PostgreSQL
POSTGRES_DB=content_factory
POSTGRES_USER=content_factory
POSTGRES_PASSWORD=change-me

# n8n
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_HOST=publisher.hodor.com.pl
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://publisher.hodor.com.pl/
WEBHOOK_URL=https://publisher.hodor.com.pl/
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=Europe/Warsaw

# self-hosted model worker (baseline AI path; no hosted quota fallback)
MODEL_WORKER_PORT=3002
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=qwen3:14b
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct
MODEL_REQUEST_TIMEOUT_MS=150000

# media-worker
MEDIA_WORKER_PORT=3001

# External providers are added only when their milestone starts.
# Never put real secrets in this file.

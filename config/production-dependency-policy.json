{
  "version": 1,
  "baseline": "self_hosted_no_quota_ai",
  "orchestrator": "n8n",
  "mandatory_model_provider": "ollama_self_hosted",
  "mandatory_model_endpoint": "http://model-worker:3002/generate",
  "hosted_ai_fallback_allowed": false,
  "forbidden_required_ai_hosts": [
    "generativelanguage.googleapis.com",
    "api.openai.com",
    "api.anthropic.com",
    "api.x.ai",
    "openrouter.ai"
  ],
  "forbidden_quota_workarounds_for_required_ai": [
    "retry_on_quota",
    "quota_sleep",
    "quota_wait",
    "rate_limit_scheduler"
  ],
  "tts_baseline": "microsoft_edge_readaloud",
  "n8n_workflows": [
    "n8n/workflows/WF01-create-content-job.json",
    "n8n/workflows/WF02-plan-script-and-scenes.json",
    "n8n/workflows/WF03-natural-edge-voice.json",
    "n8n/workflows/WF04-visual-sourcing.json",
    "n8n/workflows/WF05-video-render.json",
    "n8n/workflows/V4-model-gateway.json"
  ]
}

\ No newline at end of file
+    return best[1]
+
+def measured_revision_feedback(reply, window):
+    """Expose measured length errors to the one already-budgeted repair call."""
+    sentences=[]
+    if not isinstance(reply,dict):
+        raise ValueError('completed sentence object required')
+    for beat,row in reply.items():
+        if not isinstance(row,dict):
+            raise ValueError('completed sentence object required')
+        for field,text in row.items():
+            if not isinstance(text,str):
+                raise ValueError('completed sentence text required')
+            sentences.append({'beat':beat,'field':field,'characters':len(text.strip()),
+                              'words':len(text.split())})
+    if not sentences or len(sentences)>32:
+        raise ValueError('bounded completed sentence set required')
+    text=' '.join(text.strip() for row in reply.values() for text in row.values())
+    return {'observed_words':len(text.split()),'observed_characters':len(text),
+            'target_words':window['target_words'],
+            'target_characters':window['target_characters'],
+            'character_change_needed':window['target_characters']-len(text),
+            'word_change_needed':window['target_words']-len(text.split()),
+            'direction':'shorten' if len(text)>window['target_characters'] else 'expand',
+            'sentences':sentences}

  "model_calls": [
    {
      "key": "material-brief",
      "result": {
        "facts": [
          {
            "id": "fact-1",
            "text": "Будь-яка зірка головної послідовності з початковою масою, що більш ніж у 8 разів перевищує масу Сонця, може в процесі еволюції перетворитися на нейтронну зірку.",
            "support": [
              {
                "span_id": "s1-1094-2113"
              }
            ]
          },
          {
            "id": "fact-2",
            "text": "Коли все ядерне паливо в активній зоні вичерпано, ядро підтримується від гравитаційного стискання тільки тиском виродженого електронного газу.",
            "support": [
              {
                "span_id": "s1-1094-2113"
              }
            ]
          },
          {
            "id": "fact-3",
            "text": "При подальшому стисканні відбувається злиття електронів і протонів у нейтрони в процесі електронного захвату з утворенням потужного потоку електронних нейтрино.",
            "support": [
              {
                "span_id": "s1-2113-3302"
              }
            ]
          },
          {
            "id": "fact-4",
            "text": "Коли густина зірки досягає ядерної густини 4·10^17 кг/м3, тиск виродженого нейтронного ідеального газу Фермі — Дірака зупиняє стискання.",
            "support": [
              {
                "span_id": "s1-2113-3302"
              }
            ]
          },
          {
            "id": "fact-5",
            "text": "Падіння зовнішньої оболонки зірки на нейтронне ядро зупиняється, і вона відкидається від ядра потоком нейтрино, при цьому зірка перетворюється на наднову.",
            "support": [
              {
                "span_id": "s1-2113-3302"
              }
            ]
          },
          {
            "id": "fact-6",
            "text": "Після розсіювання зовнішньої оболонки від зірки залишається зоряний залишок — нейтронна зірка, маса якої зазвичай порівняна з масою Сонця при типовому радіусі лише 10—20 кілометрів.",
            "support": [
              {
                "span_id": "s1-0-1094"
              },
              {
                "span_id": "s1-2113-3302"
              }
            ]
          },
          {
            "id": "fact-7",
            "text": "Багато нейтронних зірок володіють надзвичайно високою швидкістю осьового обертання — до кількох сотень оборотів на секунду, і надзвичайно сильним магнітним полем.",
            "support": [
              {
                "span_id": "s1-0-1094"
              }
            ]
          },
          {
            "id": "fact-8",
            "text": "У момент народження нейтронної зірки в результаті спалаху наднової її температура дуже висока — порядку 10^11 K, але вона дуже швидко падає за рахунок нейтринного охолодження.",
            "support": [
              {
                "span_id": "s1-8766-9959"
              }
            ]
          }
        ],
        "required_fact_ids": [
          "fact-1",
          "fact-3",
          "fact-6",
          "fact-7"
        ],

  "model_brief": {
    "facts": [
      {
        "id": "fact-1",
        "text": "Нейтронні зірки утворюються в результаті еволюції та подальшого гравітаційного колапсу та вибуху надзвичайно масивних зірок, початкова маса яких перевищувала масу Сонця більш ніж у 8 разів.",
        "support": [
          {
            "span_id": "s1-1094-2113"
          }
        ]
      },
      {
        "id": "fact-2",
        "text": "Під час сильного стискання та електронного захоплення в недрах протозвезди протони та електрони зливаються, утворюючи нейтрони та потужний потік електронних нейтрино.",
        "support": [
          {
            "span_id": "s1-2113-3302"
          }
        ]
      },
      {
        "id": "fact-3",
        "text": "Коли густина досягає ядерних значень 4·10^17 кг/м³, тиск виродженого нейтронного газу зупиняє подальше стискання зірки.",
        "support": [
          {
            "span_id": "s1-2113-3302"
          }
        ]
      },
      {
        "id": "fact-4",
        "text": "Зберігаючи закон збереження кутового моменту під час різкого зменшення радіуса, нейтронна зірка набуває надзвичайно високої швидкості обертання навколо власної осі — до кількох сотень обертів за секунду.",
        "support": [
          {
            "span_id": "s1-0-1094"
          },
          {
            "span_id": "s1-3302-4411"
          }
        ]
      },
      {
        "id": "fact-5",
        "text": "При масі, порівнянній з масою Сонця, типовий радіус нейтронної зірки становить лише 10-20 кілометрів, що зумовлює колосальну середню густину речовини.",
        "support": [
          {
            "span_id": "s1-0-1094"
          }
        ]
      },
      {
        "id": "fact-6",
        "text": "Магнітне поле на поверхні нейтронних зірок може досягати гігантських значень до 10^11 Тл і вище, створюючи потужну магнітосферу.",
        "support": [
          {
            "span_id": "s1-0-1094"
          }
        ]
      },
      {
        "id": "fact-7",
        "text": "Потужне випромінювання та заряджені частинки виливаються вузькими пучками з магнітних полюсів об'єкта, утворюючи ефект космічного маяка, який спостерігається як пульсар.",
        "support": [
          {
            "span_id": "s2-1064-2223"
          },
          {
            "span_id": "s2-20704-21762"
          }
        ]
      },
      {
        "id": "fact-8",
        "text": "Взаємодія та зіткнення нейтронних зірок у подвійних системах призводять до виникнення потужних гравітаційних хвиль і нуклеосинтезу важких елементів, таких як золото і платина.",
        "support": [
          {
            "span_id": "s2-2223-3153"
          },
          {
            "span_id": "s2-34059-35142"
          }
        ]
      }
